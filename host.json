{
  "version": "2.0",
  "logging": {
    "console": {
      "isEnabled": "true"
    },
    "fileLoggingMode": "always",
    "LogLevel": {
      "*": "Trace"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}